{
  "name": "@cgoberg/openclaw-fleet",
  "version": "0.2.0",
  "description": "SSH fleet monitoring for OpenClaw by Leassh \u2014 standalone binary or server mode against a Leassh server.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node test/smoke.test.mjs"
  },
  "files": [
    "assets/",
    "dist/",
    "skills/",
    "openclaw.plugin.json"
  ],
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=1.0.0"
    },
    "build": {
      "openclawVersion": "2026.10.7"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4",
    "@types/node": "^22"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}